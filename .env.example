# Copie para `.env.local` e preencha o que for usar. Nada aqui é obrigatório para rodar localmente.

# URL pública do app (usada em links enviados ao Slack e nas instruções do MCP).
APP_URL=http://localhost:3000

# Banco de dados. Vazio = PGlite embutido em ./.data/pglite (só para desenvolvimento).
# Produção: Postgres 15+, ex.: postgres://barca:barca@localhost:5432/barca
DATABASE_URL=

# Slack (docs/integrations/slack.md)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Shopify: segredo usado para assinar os webhooks (docs/integrations/shopify.md)
SHOPIFY_WEBHOOK_SECRET=

# Digital Manager Guru: token da conta, enviado no corpo de cada webhook (docs/integrations/guru.md)
GURU_API_TOKEN=
